# Copy to .env (never commit .env).
DATABASE_URL="postgresql://lifeos:lifeos@localhost:5432/lifeos_dev"
# Used by the integration tests; they truncate this database.
TEST_DATABASE_URL="postgresql://lifeos:lifeos@localhost:5432/lifeos_test"

# AI provider. Leave ANTHROPIC_API_KEY empty to run fully offline: capture uses
# the local rules classifier and the advisor shows retrieved context only.
AI_PROVIDER="anthropic"          # anthropic | none
ANTHROPIC_API_KEY=""
AI_MODEL="claude-opus-5-5"

# Set to "true" only behind HTTPS (production). Controls the Secure cookie flag.
COOKIE_SECURE="false"
# Public origin, used for the CSRF Origin check on mutating requests.
APP_ORIGIN="http://localhost:3000"
